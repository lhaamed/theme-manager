/* {{name}} starter styles. Plain CSS is also valid SCSS.
   Enable a Sass build before adding Sass variables, imports or mixins. */
:root { color-scheme: light; --theme-ink: #172c32; --theme-muted: #586e73; --theme-accent: #0f766e; --theme-line: #dce6e4; }
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #f5f8f7; color: var(--theme-ink); font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
a { color: inherit; }
button { font: inherit; }
.theme-shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
.theme-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 30px; border-bottom: 1px solid var(--theme-line); }
.theme-brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 20px; font-weight: 750; }
.theme-logo { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--theme-accent); color: white; font-size: 28px; line-height: 1; }
.theme-caption, .theme-footer { color: var(--theme-muted); font-size: 13px; }
.theme-hero { padding-block: clamp(64px, 9vw, 120px) 60px; max-width: 820px; }
.theme-badge { display: inline-flex; align-items: center; gap: 9px; padding: 6px 12px; border: 1px solid #c9e4dd; border-radius: 100px; background: #e8f3ef; color: #17665b; font-size: 12px; font-weight: 600; }
.theme-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--theme-accent); }
h1 { margin-block: 22px 18px; max-width: 100%; overflow-wrap: anywhere; font-size: clamp(40px, 6.5vw, 76px); font-weight: 650; line-height: 1.08; letter-spacing: -.055em; }
.theme-lead { max-width: 610px; color: var(--theme-muted); font-size: 18px; }
.theme-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 30px; }
.theme-button { border: 0; border-radius: 9px; padding: 13px 20px; background: var(--theme-accent); color: white; cursor: pointer; font-weight: 600; }
.theme-button:hover { background: #115e59; }
.theme-link { text-decoration: none; font-size: 14px; font-weight: 600; }
a:focus-visible, button:focus-visible { outline: 3px solid #38bdf8; outline-offset: 4px; }
.theme-status { min-height: 24px; margin-top: 18px; color: var(--theme-muted); font-size: 13px; }
.theme-status.is-success { color: var(--theme-accent); font-weight: 600; }
.theme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding-bottom: 80px; }
.theme-card { border: 1px solid var(--theme-line); border-radius: 16px; background: white; padding: 26px; }
.theme-step { color: var(--theme-accent); text-transform: uppercase; letter-spacing: .09em; font-size: 11px; font-weight: 700; }
h2 { margin-block: 17px 10px; font-size: 20px; letter-spacing: -.025em; }
.theme-card p { margin: 0; color: var(--theme-muted); font-size: 14px; }
code { overflow-wrap: anywhere; font-size: .9em; color: var(--theme-ink); }
.theme-footer { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--theme-line); padding-block: 24px; }
@media (max-width: 700px) { .theme-grid { grid-template-columns: 1fr; padding-bottom: 48px; } .theme-caption { display: none; } .theme-footer { flex-direction: column; gap: 4px; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
